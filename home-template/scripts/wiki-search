#!/usr/bin/env python3
"""Zero-dependency BM25 search engine over repos/team-wiki using Python's built-in sqlite3 FTS5.

Replaces external `@tobilu/qmd` CLI (and its local LLM / C++ dependencies) while
maintaining full backward compatibility with `home-doctor` and existing `.qmd/` layout.

Usage (from `home/` root):
  python3 scripts/wiki-search init                 # or `update` (auto-initializes .qmd/)
  python3 scripts/wiki-search update [--pull]      # rebuilds .qmd/index.sqlite (optionally git pulls repos/team-wiki)
  python3 scripts/wiki-search search "<query>"     # BM25 search over repos/team-wiki (excludes index.md, log.md, README.md)
  python3 scripts/wiki-search "<query>"            # shorthand for `search "<query>"`
"""

from __future__ import annotations

import re
import sqlite3
import subprocess
import sys
from pathlib import Path

HOME_ROOT = Path(__file__).resolve().parent.parent
QMD_DIR = HOME_ROOT / ".qmd"
INDEX_YML = QMD_DIR / "index.yml"
INDEX_DB = QMD_DIR / "index.sqlite"
WIKI_DIR = HOME_ROOT / "repos" / "team-wiki"

IGNORE_FILES = {"index.md", "log.md", "README.md"}
SKIP_DIRS = {".git", "node_modules", ".qmd"}

DEFAULT_INDEX_YML = """collections:
  team-wiki:
    path: repos/team-wiki
    pattern: "**/*.md"
    ignore:
      - index.md
      - log.md
      - README.md
"""


def segment_cjk(text: str) -> str:
    """Pad CJK ideographs with spaces so SQLite unicode61 tokenizer indexes both CJK & ASCII identifiers."""
    return re.sub(r"([\u4e00-\u9fff])", r" \1 ", text)


def parse_title(text: str, fallback: str) -> str:
    if text.startswith("---\n") and (end := text.find("\n---", 4)) > 0:
        for line in text[4:end].splitlines():
            if line.strip().startswith("title:"):
                return line.split(":", 1)[1].strip().strip("\"'")
    for line in text.splitlines():
        if line.startswith("# "):
            return line[2:].strip()
    return fallback


def ensure_index_yml() -> None:
    QMD_DIR.mkdir(parents=True, exist_ok=True)
    if not INDEX_YML.exists() or "ignore:" not in INDEX_YML.read_text(encoding="utf-8"):
        INDEX_YML.write_text(DEFAULT_INDEX_YML, encoding="utf-8")


def collect_markdown_files() -> list[Path]:
    if not WIKI_DIR.is_dir():
        return []
    files: list[Path] = []
    for p in sorted(WIKI_DIR.rglob("*.md")):
        if SKIP_DIRS & set(p.parts):
            continue
        if p.name in IGNORE_FILES:
            continue
        files.append(p)
    return files


def cmd_update(pull: bool = False) -> int:
    ensure_index_yml()
    # Remove any accidental .qmd inside repos/team-wiki
    accidental_qmd = WIKI_DIR / ".qmd"
    if accidental_qmd.exists():
        import shutil
        if accidental_qmd.is_dir():
            shutil.rmtree(accidental_qmd)
        else:
            accidental_qmd.unlink()

    if pull and (WIKI_DIR / ".git").exists():
        print("Pulling latest repos/team-wiki...")
        subprocess.run(["git", "-C", str(WIKI_DIR), "pull", "--ff-only"], check=False)

    if INDEX_DB.exists():
        INDEX_DB.unlink()

    conn = sqlite3.connect(str(INDEX_DB))
    with conn:
        try:
            conn.execute(
                "CREATE VIRTUAL TABLE docs USING fts5("
                "path UNINDEXED, title, raw_body UNINDEXED, seg_title, seg_body, "
                "tokenize='unicode61')"
            )
            has_fts5 = True
        except sqlite3.OperationalError:
            has_fts5 = False
            conn.execute(
                "CREATE TABLE docs (path TEXT, title TEXT, raw_body TEXT, seg_title TEXT, seg_body TEXT)"
            )

        files = collect_markdown_files()
        for f in files:
            rel = f.relative_to(HOME_ROOT).as_posix()
            text = f.read_text(encoding="utf-8", errors="replace").replace("\r\n", "\n")
            title = parse_title(text, f.stem)
            conn.execute(
                "INSERT INTO docs VALUES (?, ?, ?, ?, ?)",
                (rel, title, text, segment_cjk(title), segment_cjk(text)),
            )
    conn.close()
    engine = "SQLite FTS5 BM25" if has_fts5 else "SQLite fallback"
    print(f"OK: Indexed {len(files)} wiki pages into .qmd/index.sqlite ({engine}, 0 external dependencies)")
    return 0


def build_fts_query(raw_query: str) -> list[str]:
    cleaned = re.sub(r"[^\w\u4e00-\u9fff]+", " ", segment_cjk(raw_query))
    return [tok for tok in cleaned.split() if tok]


def extract_snippet(raw_body: str, raw_query: str, max_lines: int = 4) -> str:
    raw_terms = [t for t in re.split(r"\s+", raw_query.strip()) if t]
    lines = [ln.strip() for ln in raw_body.splitlines() if ln.strip() and not ln.strip().startswith("---")]
    matched: list[str] = []
    for ln in lines:
        low = ln.lower()
        if any(t.lower() in low for t in raw_terms):
            matched.append(ln)
            if len(matched) >= max_lines:
                break
    if not matched:
        matched = lines[:max_lines]
    return "\n    ".join(matched)


def cmd_search(raw_query: str, limit: int = 5) -> int:
    if not INDEX_DB.exists():
        cmd_update(pull=False)

    tokens = build_fts_query(raw_query)
    if not tokens:
        print("Empty search query.")
        return 1

    conn = sqlite3.connect(str(INDEX_DB))
    rows = []
    try:
        # Step 1: strict match (all tokens present)
        and_expr = " AND ".join(f'"{t}"' for t in tokens)
        rows = conn.execute(
            "SELECT path, title, raw_body, bm25(docs) AS score FROM docs "
            "WHERE docs MATCH ? ORDER BY score LIMIT ?",
            (and_expr, limit),
        ).fetchall()
        # Step 2: broaden to OR match if strict AND had no hits
        if not rows and len(tokens) > 1:
            or_expr = " OR ".join(f'"{t}"' for t in tokens)
            rows = conn.execute(
                "SELECT path, title, raw_body, bm25(docs) AS score FROM docs "
                "WHERE docs MATCH ? ORDER BY score LIMIT ?",
                (or_expr, limit),
            ).fetchall()
    except sqlite3.OperationalError:
        # Fallback if FTS5 is unavailable
        all_rows = conn.execute("SELECT path, title, raw_body FROM docs").fetchall()
        scored = []
        for path, title, raw_body in all_rows:
            hay = (title + "\n" + raw_body).lower()
            hits = sum(hay.count(t.lower()) for t in tokens)
            if hits > 0:
                scored.append((path, title, raw_body, -float(hits)))
        scored.sort(key=lambda x: x[3])
        rows = scored[:limit]
    finally:
        conn.close()

    if not rows:
        print(f"No matches in repos/team-wiki for: {raw_query}")
        return 0

    for idx, (path, title, raw_body, score) in enumerate(rows, 1):
        snippet = extract_snippet(raw_body, raw_query)
        print(f"[{idx}] {path} — {title} (bm25={abs(score):.4f})")
        if snippet:
            print(f"    {snippet}")
    return 0


def main() -> int:
    args = sys.argv[1:]
    if not args or args[0] in {"-h", "--help", "help"}:
        print(__doc__.strip())
        return 0

    cmd = args[0]
    if cmd in {"init", "update", "cleanup"}:
        pull = "--pull" in args[1:]
        return cmd_update(pull=pull)
    if cmd in {"collection"}:
        # Compatibility no-op for legacy `qmd collection add ...`
        ensure_index_yml()
        print("OK: .qmd/index.yml configured for repos/team-wiki")
        return 0
    if cmd == "search":
        query = " ".join(a for a in args[1:] if not a.startswith("-"))
        return cmd_search(query)

    # Shorthand: `python3 scripts/wiki-search "<query>"`
    query = " ".join(a for a in args if not a.startswith("-"))
    return cmd_search(query)


if __name__ == "__main__":
    sys.exit(main())
